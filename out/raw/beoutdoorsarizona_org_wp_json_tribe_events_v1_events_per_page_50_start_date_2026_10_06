},{"name":"how to hunt","slug":"how-to-hunt","term_group":0,"term_taxonomy_id":160,"taxonomy":"post_tag","description":"","parent":0,"count":24,"filter":"raw","id":160,"urls":{"self":"https:\/\/beoutdoorsarizona.org\/wp-json\/tribe\/events\/v1\/tags\/160","collection":"https:\/\/beoutdoorsarizona.org\/wp-json\/tribe\/events\/v1\/tags"}}],"venue":{"id":15079,"status":"publish","date":"2019-08-05 17:20:39","date_utc":"2019-08-06 00:20:39","modified":"2019-08-05 17:20:39","modified_utc":"2019-08-06 00:20:39","url":"https:\/\/beoutdoorsarizona.org\/venue\[long]\/","venue":"5000 W Carefree Hwy, Phoenix, AZ 85086, USA","slug":"[long]","address":"2798 E Carefree Hwy","country":"United States","geo_lat":33.7991164,"geo_lng":-112.0253701,"show_map":true,"show_map_link":true,"global_id":"beoutdoorsarizona.org?id=15079","global_id_lineage":["beoutdoorsarizona.org?id=15079"]},"organizer":[{"id":13608,"author":"2","status":"publish","date":"2018-05-01 10:56:10","date_utc":"2018-05-01 17:56:10","modified":"2018-05-01 10:56:10","modified_utc":"2018-05-01 17:56:10","url":"https:\/\/beoutdoorsarizona.org\/organizer\/christian-hunters-of-america\/","organizer":"Christian Hunters of America","slug":"christian-hunters-of-america","phone":"602-309-3430","website":"christianhuntersofamerica.org","global_id":"beoutdoorsarizona.org?id=13608","global_id_lineage":["beoutdoorsarizona.org?id=13608"]}],"custom_fields":[],"is_virtual":false,"virtual_url":null,"virtual_video_source":""},{"id":62496,"global_id":"beoutdoorsarizona.org?id=62496","global_id_lineage":["beoutdoorsarizona.org?id=62496"],"author":"2","status":"publish","date":"2026-09-29 11:03:25","date_utc":"2026-09-29 18:03:25","modified":"2026-09-29 11:03:32","modified_utc":"2026-09-29 18:03:32","url":"https:\/\/beoutdoorsarizona.org\/event\/tumamoc-talks\/","rest_url":"https:\/\/beoutdoorsarizona.org\/wp-json\/tribe\/events\/v1\/events\/62496","title":"Tumamoc Talks","description":"<p><strong>The Desert Laboratory on Tumamoc Hill hosts a series of talks focused on topics that relate to the science, ecology, history, and culture of the Sonoran Desert. All talks are open to the public.<\/strong><\/p>\n<p><em><strong>Wednesday, October 14th\u00a0at 5:30pm<\/strong><\/em><\/p>\n<p><em>Ephemeral jewels: hydrology, ecology, and trails connecting the tinajas of the Pinacate<\/em><\/p>\n<p>For vast portions of the western Sonoran Desert, tinajas provide the only available surface water for humans and wildlife. These bedrock-bound stream pools may hold water for weeks to over a year after significant rainfall events, but their hydroperiods (cycles of wetting and drying) vary across tinajas. Since 2019, we have studied dozens of tinajas across the Pinacate Biosphere Reserve and Organ Pipe Cactus National Monument to measure their hydroperiods, document their aquatic biodiversity, and their use by wildlife. Dozens of species of wildlife visit tinajas in both reserves, including bighorn sheep, mountain lions, skunks, golden eagles, and migratory birds &#8212; and over 100 aquatic animal species live in their temporary waters. In the Pinacate, traces of ancient Hia-Ced and Tohono O&#8217;odham trails lead from tinaja to tinaja, demonstrating the deep cultural importance of these waterbodies as well. To more deeply connect with this landscape, and the tinajas hidden within it, we made a 5-day backpacking trip around the Pinacate volcano, hiking across lava flows and relying solely on tinajas for drinking water along the 50-mile route. This presentation will include both an overview of our scientific studies as well as a photographic travelogue of our backpacking trip across the incomparable Pinacate.<\/p>\n<p>Michael Bogan is a stream and riparian ecologist and an associate professor in the School of Natural Resources and the Environment at the University of Arizona. He has been on the faculty since 2016 and he was named the Cecil and Carol Schwalbe Endowed Chair in Cold-Blooded Research, Teaching, and Conservation in 2025. Michael and his students love and study nearly everything that lives in or near desert waters, including dragonflies, turtles, fish, and birds. Prior to his position at the University of Arizona, Michael did his graduate and postdoctoral studies at Oregon State University and the University of California, Berkeley, where he studied the impacts of stream drying and water management on aquatic biodiversity across Oregon, California, Arizona, and northern Mexico.<\/p>\n<p>Location:\u00a0The Tumamoc Hill Boathouse (base of the Hill)<\/p>\n<div>\n<div>1675 W. Anklam Rd. Tucson, AZ<\/div>\n<div>Street parking is available on Anklam, or the lot on the corner of Anklam and Silverbell.<\/div>\n<div><\/div>\n<div>Note: There is no event parking available on Tumamoc Hill.<\/div>\n<div>\n<strong>Contact us at (520) 621-6945 or\u00a0<\/strong><a href=\"mailto:tumamoc-hill@arizona.edu\"><strong>tumamoc-hill@arizona.edu<\/strong><\/a><strong>\u00a0<\/strong><\/div>\n<div><\/div>\n<div><strong>RSVP:\u00a0<\/strong><a href=\"https:\/\/forms.gle\/9WCjR1S1i2Cx3bXG7\"><strong>https:\/\/forms.gle\/9WCjR1S1i2Cx3bXG7<\/strong><\/a><strong>\u00a0<\/strong><\/div>\n<\/div>","excerpt":"","slug":"tumamoc-talks","image":false,"all_day":false,"start_date":"2026-10-14 17:30:00","start_date_details":{"year":"2026","month":"10","day":"14","hour":"17","minutes":"30","seconds":"00"},"end_date":"2026-10-14 18:30:00","end_date_details":{"year":"2026","month":"10","day":"14","hour":"18","minutes":"30","seconds":"00"},"utc_start_date":"2026-10-15 00:30:00","utc_start_date_details":{"year":"2026","month":"10","day":"15","hour":"00","minutes":"30","seconds":"00"},"utc_end_date":"2026-10-15 01:30:00","utc_end_date_details":{"year":"2026","month":"10","day":"15","hour":"01","minutes":"30","seconds":"00"},"timezone":"America\/Phoenix","timezone_abbr":"MST","cost":"Free","cost_details":{"currency_symbol":"","currency_code":"","currency_position":"","values":["0"]},"website":"https:\/\/desertl