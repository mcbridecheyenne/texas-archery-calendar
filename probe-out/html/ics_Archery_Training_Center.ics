  OB \, pd - 208 + 240 = <b>448 pts</b><br>5B. <b>Rhys E</b> 10\, USAA\, OB 
 \, pd - 84 + 59 = <b>143 pts</b><br><br>6A.<b> Finn E</b> 12\, USAA\, OB \,
  pd - 153 + 148 = <b>301 pts</b><br>----------------------------------<br>6
 B <b>Joel Y\,</b> adult\, USAA\, OB\, pd - 203 + 218 = <b>421 pts</b><br><b
