 ecurve/Barebow</td><td>30m</td><td>122cm</td></tr><tr><td>U13</td><td>Recur
 ve/Barebow</td><td>30m</td><td>122cm</td></tr><tr><td>Yeoman</td><td>Recurv
 e/Barebow</td><td>15m</td><td>122cm</td></tr><tr><td></td><td></td><td></td
 ><td></td></tr><tr><td><b>B Flight</b></td><td><b></b></td><td><b></b></td>
