{
  "expo": {
    "name": "Archery in Texas",
    "slug": "archery-in-texas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "ios": {
      "bundleIdentifier": "com.cheyennemcbride.archeryintexas",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.cheyennemcbride.archeryintexas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F2EA"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Texas Archery Calendar adds the tournaments you pick to your calendar."
        }
      ],
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-7930621070150782~2178872475"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Archery in Texas uses your photos so you can add pictures to your listings.",
          "cameraPermission": "Archery in Texas uses the camera so you can photograph gear you're selling.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "archeryintexas",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "0405b8fd-8dd8-47a5-a1d9-f7588cf8450f"
      }
    },
    "owner": "cmprograms",
    "updates": {
      "url": "https://u.expo.dev/0405b8fd-8dd8-47a5-a1d9-f7588cf8450f"
    }
  }
}
